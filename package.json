{
  "name": "kalki",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "type-check": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:up": "docker compose -f docker/docker-compose.yml up -d",
    "db:down": "docker compose -f docker/docker-compose.yml down",
    "db:seed": "bun prisma/seed.ts",
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "bun run lint && bun run type-check && bun run test",
    "e2e": "playwright test",
    "setup": "bash scripts/setup.sh",
    "logo": "node scripts/logo.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "tsc-files --noEmit"
    ],
    "*.{ts,tsx,js,json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.135",
    "@google/generative-ai": "^0.24.1",
    "@langchain/core": "^1.2.18",
    "@langchain/langgraph": "^1.5.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/pg": "^8.23.1",
    "ai": "^6.0.309",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.575.0",
    "marked": "^18.1.1",
    "next": "16.4.2",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "radix-ui": "^1.8.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4.3.3",
    "tsc-files": "^1.1.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "prisma": {
    "seed": "bun prisma/seed.ts"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "description": "Open-source AI short-video studio: multi-agent script, image, voice, animation and edit pipeline with an owner dashboard.",
  "license": "MIT",
  "author": "Harshit Wandhare",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harshitwandhare/kalki.git"
  },
  "homepage": "https://github.com/harshitwandhare/kalki#readme",
  "bugs": "https://github.com/harshitwandhare/kalki/issues",
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "lodash": "^4.18.1",
    "postcss": "^8.5.31",
    "source-map-js": "^1.2.2",
    "form-data": "^4.0.6",
    "axios": "^1.20.0",
    "ws": "^8.22.0",
    "follow-redirects": "^1.16.1",
    "fast-uri": "^3.1.8",
    "nanoid": "^3.3.20",
    "uuid": "^11.1.1",
    "baseline-browser-mapping": "^2.11.29"
  }
}
