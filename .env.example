# Copy to .env.local and fill in your own values. Never commit real keys.

# --- Core ---
DATABASE_URL="postgresql://kalki:change-me@localhost:5432/kalki_db"
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
# Path to the ffmpeg binary (defaults to `ffmpeg` on PATH)
FFMPEG_PATH=""

# --- LLM (required) ---
# Gemini writes the research, script and metadata, and embeds characters and worlds.
# https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=""

# --- Media providers: bring your own paid or free-tier key from the provider ---
STABILITY_API_KEY=""
ELEVENLABS_API_KEY=""
# Video animation: set at least one
SEEDANCE_API_KEY=""
KLING_API_KEY=""

# --- Optional WhatsApp control (via a gateway you run yourself) ---
# Both must be set or the endpoint stays disabled.
KALKI_WEBHOOK_SECRET=""
WHATSAPP_OWNER_NUMBER=""

# --- Seeding (npm run db:seed) ---
SEED_OWNER_EMAIL=""
# 12+ characters
SEED_OWNER_PASSWORD=""

# Docker Compose database password (docker/docker-compose.yml)
POSTGRES_PASSWORD="change-me"
