// Kalki - AI Video Orchestration Platform
// Prisma Schema with pgvector support

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String     @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role       @default(VIEWER)
  status        UserStatus @default(PENDING)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  accounts  Account[]
  sessions  Session[]
  channels  Channel[]
  reels     Reel[]

  @@map("users")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

// ─── Channel ─────────────────────────────────────────────────────────────────

model Channel {
  id             String        @id @default(cuid())
  userId         String
  name           String
  slug           String        @unique
  theme          ChannelTheme
  targetAudience String
  language       Language      @default(ENGLISH)
  description    String?
  aboutText      String?
  bannerPrompt   String?
  logoPrompt     String?
  status         ChannelStatus @default(ACTIVE)
  config         Json          @default("{}")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  characters Character[]
  worlds     World[]
  reels      Reel[]

  @@map("channels")
}

// ─── Character Identity (Soul Document) ──────────────────────────────────────

model Character {
  id            String                      @id @default(cuid())
  channelId     String
  name          String
  soulDocument  Json
  embedding     Unsupported("vector(768)")?
  referenceUrls String[]
  loraPath      String?
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt

  channel Channel         @relation(fields: [channelId], references: [id], onDelete: Cascade)
  reels   ReelCharacter[]

  @@map("characters")
}

// ─── World Memory ─────────────────────────────────────────────────────────────

model World {
  id            String                      @id @default(cuid())
  channelId     String
  name          String
  description   String
  visualStyle   String
  embedding     Unsupported("vector(768)")?
  referenceUrls String[]
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  reels   Reel[]

  @@map("worlds")
}

// ─── Video Assets ─────────────────────────────────────────────────────────────

model Reel {
  id           String       @id @default(cuid())
  userId       String
  channelId    String
  worldId      String?
  prompt       String
  title        String?
  script       Json?
  status       ReelStatus   @default(PENDING)
  language     Language     @default(ENGLISH)
  duration     Int          @default(60)
  quality      VideoQuality @default(HD_1080P)
  style        VideoStyle   @default(CINEMATIC)
  audioConfig  Json         @default("{}")

  thumbnailUrl String?
  videoUrl     String?
  rawAssets    Json         @default("[]")

  ytTitle       String?
  ytDescription String?
  ytTags        String[]
  ytCategory    String?
  ytAudienceAge String?

  pipelineState Json       @default("{}")
  agentLogs     AgentLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User            @relation(fields: [userId], references: [id])
  channel    Channel         @relation(fields: [channelId], references: [id])
  world      World?          @relation(fields: [worldId], references: [id])
  characters ReelCharacter[]

  @@map("reels")
}

model ReelCharacter {
  reelId      String
  characterId String

  reel      Reel      @relation(fields: [reelId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@id([reelId, characterId])
  @@map("reel_characters")
}

// ─── Agent Logs (Episodic Memory) ────────────────────────────────────────────

model AgentLog {
  id            String    @id @default(cuid())
  reelId        String
  agent         AgentType
  action        String
  input         Json?
  output        Json?
  thinkingBlock String?
  status        LogStatus @default(RUNNING)
  durationMs    Int?
  createdAt     DateTime  @default(now())

  reel Reel @relation(fields: [reelId], references: [id], onDelete: Cascade)

  @@map("agent_logs")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  OWNER
  EDITOR
  VIEWER
}

enum UserStatus {
  PENDING
  ACTIVE
  REJECTED
}

enum ChannelTheme {
  INDIAN_GEN_Z
  US_PARENTS
  MOTIVATION_KARMA
  LOVE_RELATIONSHIPS
  ASTROLOGY_SPIRITUAL
  FINANCE_CRYPTO
  TECH_AI
  ADVENTURE_TRAVEL
  COMEDY_MEMES
  HORROR_THRILLER
  KIDS_EDUCATION
  CUSTOM
}

enum ChannelStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum Language {
  ENGLISH
  HINDI
  MARATHI
  TAMIL
  TELUGU
  BENGALI
}

enum ReelStatus {
  PENDING
  SCRIPTING
  GENERATING_IMAGES
  ANIMATING
  POST_PRODUCTION
  READY
  FAILED
}

enum VideoQuality {
  HD_720P
  HD_1080P
  UHD_2K
  UHD_4K
}

enum VideoStyle {
  CINEMATIC
  STORYTELLING
  POV
  QUICK_WATCH
  DOCUMENTARY
  ANIMATED_CARTOON
  ANIME
  REALISTIC_HUMAN
}

enum AgentType {
  DIRECTOR
  SCREENWRITER
  ARTIST
  ANIMATOR
  PRODUCER
}

enum LogStatus {
  RUNNING
  COMPLETED
  FAILED
}
